macro(benchmark_option NAME DEFAULT_VALUE)
    if (NOT DEFINED ${NAME})
        set(${NAME} ${DEFAULT_VALUE})
    endif()
    message(STATUS "  ${NAME}=${${NAME}}")
endmacro()

message(STATUS "Build options:")
benchmark_option(OUTPUT_DIR "${CMAKE_BINARY_DIR}/bin")
benchmark_option(BUILD_SINGLE_API_BINARIES ON)
benchmark_option(BUILD_ALL_API_BINARIES ON)
if (UNIX)
    benchmark_option(USE_PCIACCESS ON)
else()
    set(USE_PCIACCESS OFF)
endif()
